{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --watch ../../packages/shared/src src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node-pg-migrate up --config node-pg-migrate.config.js --database-url-var POSTGRES_URL",
    "db:migrate:down": "node-pg-migrate down --config node-pg-migrate.config.js --database-url-var POSTGRES_URL"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "postgres": "^3.4.9",
    "resend": "^6.18.0",
    "shared": "workspace:*",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "node-pg-migrate": "^7.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}